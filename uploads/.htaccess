# Pasta de arquivos enviados por usuários: nada aqui pode ser executado.
# Esta regra vale também para todas as subpastas (avatars/, venues/...).

# Remove qualquer handler de script, mesmo em nomes como "foto.php.jpg"
<IfModule mod_mime.c>
    RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .pht .phps .cgi .pl .py .sh
    RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .pht .phps
</IfModule>

# Nega tudo e libera apenas imagens
<IfModule mod_authz_core.c>
    Require all denied
    <FilesMatch "\.(?i:jpe?g|png|gif)$">
        Require all granted
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    Order Allow,Deny
    Deny from all
    <FilesMatch "\.(?i:jpe?g|png|gif)$">
        Order Deny,Allow
        Allow from all
    </FilesMatch>
</IfModule>
